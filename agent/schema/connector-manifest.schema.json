{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgepilot.dev/schema/connector-manifest.schema.json",
  "title": "ConnectorManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "category",
    "auth",
    "capabilities",
    "riskLevel",
    "supportsMcp",
    "commercialLicense"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_-]{2,64}$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "category": {
      "type": "string",
      "enum": ["git", "cloud", "database", "communication", "browser", "design", "local"]
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scopes"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["oauth2", "api_key", "github_app", "browser_session", "local"]
        },
        "scopes": { "type": "array", "items": { "type": "string" } },
        "authorizationUrl": { "type": "string", "format": "uri" },
        "tokenUrl": { "type": "string", "format": "uri" },
        "requiresPkce": { "type": "boolean" },
        "tokenTtlSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_.]+$" }
    },
    "riskLevel": { "$ref": "common.defs.json#/$defs/riskLevel" },
    "supportsMcp": { "type": "boolean" },
    "commercialLicense": {
      "type": "string",
      "description": "SPDX id or 'PROPRIETARY-REVIEW-REQUIRED'"
    },
    "rateLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rpm": { "type": "integer", "minimum": 0 },
        "rpd": { "type": "integer", "minimum": 0 },
        "documentedAt": { "type": "string", "format": "date" }
      }
    },
    "dataResidency": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
