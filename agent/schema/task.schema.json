{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forgepilot.dev/schema/task.schema.json",
  "title": "AgentTask",
  "description": "The unit of work handed to a specialist agent. Small, bounded, reviewable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "title",
    "type",
    "objective",
    "acceptanceCriteria",
    "allowedPaths",
    "forbiddenActions",
    "dependencies",
    "riskLevel",
    "approvalRequired"
  ],
  "properties": {
    "taskId": { "type": "string", "pattern": "^task_[a-z0-9_]{1,64}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 200 },
    "type": {
      "type": "string",
      "enum": [
        "repo_analysis",
        "scaffold",
        "database",
        "backend",
        "frontend",
        "integration",
        "test",
        "security",
        "devops",
        "docs",
        "browser"
      ]
    },
    "objective": { "type": "string", "minLength": 10 },
    "context": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 5 }
    },
    "allowedPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbiddenActions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^task_[a-z0-9_]{1,64}$" }
    },
    "lockedPaths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional explicit locks; defaults to allowedPaths."
    },
    "assignedAgent": { "type": "string" },
    "riskLevel": { "$ref": "common.defs.json#/$defs/riskLevel" },
    "approvalRequired": { "type": "boolean" },
    "status": { "$ref": "common.defs.json#/$defs/taskStatus" },
    "estimatedTokens": { "type": "integer", "minimum": 0 },
    "definitionOfDone": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Machine-checkable gates for this task (lint, typecheck, test, build, secret-scan)."
    }
  }
}
